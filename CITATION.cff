  - CC-BY-4.0
repository-code: "https://github.com/CominErosBiostatistic/biostat-compass"
url: "https://cominerosbiostatistic.github.io/biostat-compass/"
keywords:
  - biostatistics
  - statistical model selection
  - epidemiology
  - clinical research
  - decision support
  - statistics education
